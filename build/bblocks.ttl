<https://avillar.github.io/ontology-crs/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - SRS Ontology" ;
    dct:abstract "Building blocks for implementation of the OGC SRS ontology"^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:description """Each building block defines a reusable JSON schema that is mapped to the equivalent SRS Ontology concept.

Each fragment allows for transparent and validatable use of JSON-LD contexts to map schema elements to equivalent terms from the GeoSPARQL ontology. 

 _These components are under review by the GeoSPARQL SWG as candidate canonical implementations._ 

 Each building block allows for examples transformed to RDF, which in turn allows for the use of SHACL rules to enforce the semantics of the GeoSPARQL specifications.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:modified "2026-10-07T16:45:16.788144"^^xsd:dateTime ;
    owl:imports <https://opengeospatial.github.io/bblocks/register.json> ;
    skos:hasTopConcept <bblocks://ogc.geosrs.app>,
        <bblocks://ogc.geosrs.co>,
        <bblocks://ogc.geosrs.cs>,
        <bblocks://ogc.geosrs.datum>,
        <bblocks://ogc.geosrs.planet>,
        <bblocks://ogc.geosrs.projection>,
        <bblocks://ogc.geosrs.requirements.alignments>,
        <bblocks://ogc.geosrs.requirements.conventions>,
        <bblocks://ogc.geosrs.requirements.instances>,
        <bblocks://ogc.geosrs.requirements.jsonld-context>,
        <bblocks://ogc.geosrs.requirements.references>,
        <bblocks://ogc.geosrs.requirements.revision-history>,
        <bblocks://ogc.geosrs.requirements.scope>,
        <bblocks://ogc.geosrs.requirements.shacl-shapes>,
        <bblocks://ogc.geosrs.requirements.terms>,
        <bblocks://ogc.geosrs.srs> ;
    skos:prefLabel "Building Blocks - SRS Ontology" ;
    prof:hasResource [ rdfs:label "This Building Blocks Register in JSON format" ;
            dct:type "application/json" ;
            ns2:relation <http://www.iana.org/assignments/relation/self> ;
            ns1:hasTarget <https://avillar.github.io/ontology-crs/build/register.json> ],
        [ rdfs:label "This Building Blocks Register in JSON-LD format" ;
            dct:type "application/ld+json" ;
            ns2:relation <http://www.iana.org/assignments/relation/self> ;
            ns1:hasTarget <https://avillar.github.io/ontology-crs/build/bblocks.jsonld> ],
        [ rdfs:label "This Building Blocks Register in RDF Turtle format" ;
            dct:type "text/turtle" ;
            ns2:relation <http://www.iana.org/assignments/relation/self> ;
            ns1:hasTarget <https://avillar.github.io/ontology-crs/build/bblocks.ttl> ] ;
    foaf:homepage <https://avillar.github.io/ontology-crs/bblocks> ;
    bblocks:hasValidationReport <https://avillar.github.io/ontology-crs/build/tests/report.html> .

