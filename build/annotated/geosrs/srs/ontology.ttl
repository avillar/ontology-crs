@prefix geosrs: <https://w3id.org/geosrs/> .
@prefix geosrs_srs: <https://w3id.org/geosrs/srs/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/geosrs> a owl:Ontology ;
    rdfs:label "SRS Ontology"@en ;
    vann:preferredNamespacePrefix "geosrs"^^xsd:string ;
    vann:preferredNamespaceUri "https://w3id.org/geosrs/"^^xsd:anyURI .

geosrs:CartesianCoordinateSystem a owl:Class ;
    rdfs:label "Cartesian Coordinate System"@en ;
    rdfs:subClassOf geosrs:CoordinateSystem ;
    skos:definition "Coordinate system which gives the position of points relative to n mutually perpendicular axes. Cf. ISO 19111:2007:2007-07, tables 15 and 18."@en .

geosrs:CoordinateSystemAxis a owl:Class ;
    rdfs:label "Coordinate System Axis"@en ;
    skos:definition "Axis relative to which a coordinate of a point is specified in a coordinate system. See ISO 19111:2007:2007-07, part 9.3, table 27 and annex B.2.2."@en .

geosrs:EPSGcode a owl:DatatypeProperty ;
    rdfs:label "EPSG code"@en ;
    rdfs:range <xsd:string> ;
    skos:definition "Identifier of this resource in the EPSG Geodetic Parameter Dataset."@en .

geosrs:Ellipsoid a owl:Class ;
    rdfs:label "Ellipsoid"@en ;
    skos:definition "Surface formed by the rotation of an ellipse about its minor axis, defined by a semi-major axis and a flattening parameter and fairly geocentric. NB : It is a mathematical model of the geoid, i.e. the Earth without its relief. Many geodetic ellipsoids exist. Cf. ISO 19111:2007:2007-07, part 10.2.2, table 36 and annex B.3.2.3."@en .

geosrs:GeodeticDatum a owl:Class ;
    rdfs:label "Geodetic Datum"@en ;
    skos:definition "Datum describing the relation of a two- or three-dimensional coordinate system to the Earth. Cf. ISO 19111:2007:2007-07, part 10.2, table 34 and annex B.3.2."@en .

geosrs:LinearCoordinateSystem a owl:Class ;
    rdfs:label "Linear Coordinate System"@en ;
    rdfs:subClassOf geosrs:CoordinateSystem ;
    skos:definition "One-dimensional coordinate system in which a linear feature forms the axis."@en .

geosrs:OperationParameter a owl:Class ;
    rdfs:label "Operation Parameter"@en ;
    rdfs:subClassOf geosrs:GeneralOperationParameter ;
    skos:definition "Parameter used by a method to perform an operation on coordinates. Note: Most parameter values are numeric, but other types of parameter values are possible. See ISO 19111:2007:2007-07, table 52 and annex B.4.5."@en .

geosrs:OperationParameterValue a owl:Class ;
    rdfs:label "Operation Parameter Value"@en ;
    rdfs:subClassOf geosrs:GeneralParameterValue ;
    skos:definition "Value of a parameter used by a method to perform an operation on coordinates. See ISO 19111:2007:2007-07, table 55."@en .

geosrs:PrimeMeridian a owl:Class ;
    rdfs:label "Prime meridian"@en ;
    skos:definition "Meridian from which the longitudes of other meridians are quantified. Cf. ISO 19111:2007:2007-07, part 10.2.1, table 35 and annex B.3.2.2."@en .

geosrs:SphericalCoordinateSystem a owl:Class ;
    rdfs:label "Spherical Coordinate System"@en ;
    rdfs:subClassOf geosrs:CoordinateSystem ;
    skos:definition "Three-dimensional coordinate system in Euclidean space with one distance measured from the origin and two angular coordinates"@en .

geosrs:Transformation a owl:Class ;
    rdfs:label "Transformation"@en ;
    rdfs:subClassOf geosrs:SingleOperation ;
    owl:disjointWith geosrs:Conversion ;
    skos:definition "Coordinate operation in which the two coordinate reference systems are based on different datums. Cf. ISO 19111:2007:2007-07, table 44."@en .

geosrs:VerticalCoordinateSystem a owl:Class ;
    rdfs:label "Vertical Coordinate System"@en ;
    rdfs:subClassOf geosrs:CoordinateSystem ;
    owl:disjointWith geosrs:OrdinalCoordinateSystem ;
    skos:definition "One-dimensional coordinate system used for gravity related height or depth measurements. Cf. ISO 19111:2007:2007-07, tables 15 and 25."@en .

geosrs:VerticalDatum a owl:Class ;
    rdfs:label "Vertical Datum"@en ;
    rdfs:subClassOf geosrs:Datum ;
    skos:definition "Datum describing the relation of gravity-related heights or depths to the Earth. Cf. ISO 19111:2007:2007-07, table 41 and annex B.3.3."@en .

geosrs:asProj4 a owl:DatatypeProperty ;
    rdfs:label "PROJ4 string"@en ;
    rdfs:domain geosrs_srs:CRS ;
    rdfs:range geosrs_srs:proj4Literal ;
    skos:definition "PROJ4 string defining a CRS. Note: this paradigm is ambiguous and presently considered outdated."@en .

geosrs:asProjJSON a owl:DatatypeProperty ;
    rdfs:label "PROJ JSON definition"@en ;
    rdfs:domain geosrs_srs:CRS ;
    rdfs:range geosrs_srs:projJSONLiteral ;
    skos:definition "CRS definition encoded as a JSON object interpretable by PROJ4."@en .

geosrs:asWKT a owl:DatatypeProperty ;
    rdfs:label "WKT definition"@en ;
    rdfs:domain geosrs_srs:CRS ;
    rdfs:range geosrs_srs:wktLiteral ;
    skos:definition "CRS definition encoded according to the Well Known Text structure. Cf. ISO 19162:2019. "@en .

geosrs:baseCRS a owl:ObjectProperty ;
    rdfs:label "Base CRS"@en ;
    rdfs:domain geosrs_srs:ProjectedCRS ;
    rdfs:range geosrs_srs:GeodeticCRS ;
    skos:definition "The geodetic coordinate reference system on which a projected coordinate reference system is based. Cf. ISO 19111:2007:2007-07, table 11, association role baseCRS."@en .

geosrs:conversion a owl:ObjectProperty ;
    rdfs:label "Defined by conversion"@en ;
    rdfs:domain geosrs_srs:CRS ;
    rdfs:range geosrs:Conversion ;
    skos:definition "The conversion used to define a projected coordinate reference system. Cf. ISO 19111:2007:2007-07, table 7, named association Definition."@en .

geosrs:coordinateSystem a owl:ObjectProperty ;
    rdfs:label "Coordinate system"@en ;
    rdfs:domain geosrs_srs:CRS ;
    rdfs:range geosrs:CoordinateSystem ;
    skos:definition "The property relates a coordinate reference system to its coordinate system"@en .

geosrs:datum a owl:ObjectProperty ;
    rdfs:label "Datum"@en ;
    rdfs:domain geosrs_srs:CRS ;
    rdfs:range geosrs:Datum ;
    skos:definition "The property relates a coordinate reference system to a datum"@en .

geosrs:datumEnsemble a owl:ObjectProperty ;
    rdfs:label "Datum Ensemble"@en ;
    rdfs:domain geosrs_srs:SingleCRS ;
    rdfs:range <https://w3id.org/geosrs/datum/DatumEnsemble> ;
    skos:definition "Indicates a single CRS referring to a collection of one or more datums (Datum Ensemble)"@en .

geosrs:domainOfValidity a owl:ObjectProperty ;
    rdfs:label "Domain of validity"@en ;
    rdfs:domain geosrs_srs:CRS ;
    rdfs:range geosrs_srs:AreaOfUse ;
    skos:definition "Geographic area or time interval in which the referring object is valid. Cf. ISO 19111:2007:2007-07, tables 4, 33 and 42, attribute domainOfValidity."@en .

geosrs:method a owl:ObjectProperty ;
    rdfs:label "Method"@en ;
    rdfs:domain geosrs_srs:CRS ;
    rdfs:range geosrs:CoordinateOperation .

geosrs_srs:AxesList a owl:Class ;
    rdfs:label "Axes List"@en ;
    skos:definition "Ordered list of coordinate system axes."@en .

geosrs_srs:BoundCRS a owl:Class ;
    rdfs:label "Bound Coordinate Reference System"@en ;
    rdfs:subClassOf geosrs_srs:CRS .

geosrs_srs:EngineeringCRS a owl:Class ;
    rdfs:label "Engineering Coordinate Reference System"@en ;
    rdfs:subClassOf geosrs_srs:CRS ;
    skos:definition "A contextually local coordinate reference system which can be divided into two broad categories: - earth-fixed systems applied to engineering activities on or near the surface of the earth; - CRSs on moving platforms such as road vehicles, vessels, aircraft or spacecraft."@en .

geosrs_srs:Extent a owl:Class ;
    rdfs:label "Extent"@en ;
    skos:definition "Geographic area or time interval in which the referring object is valid. Cf. ISO 19115-1:2014:2014-04, part 6.6.1 and table B.15 line 335."@en .

geosrs_srs:GeocentricCRS a owl:Class ;
    rdfs:label "Geocentric Coordinate Reference System"@en ;
    rdfs:subClassOf geosrs_srs:CRS ;
    skos:definition "A cartesian coordinate reference system that represents locations in the vicinity of the Earth (including its surface, interior, atmosphere, and surrounding outer space) as X, Y, and Z measurements from its center of mass. Commonly used to track the orbits of satellites. "@en .

geosrs_srs:GeographicBoundingBox a owl:Class ;
    rdfs:label "Geographic Bounding Box"@en ;
    skos:definition "Frame delimiting an area of interest. See ISO 19115-1:2014:2014-04, part 6.6.1 and table B.15.1 line 344."@en .

geosrs_srs:GeographicCRS a owl:Class ;
    rdfs:label "Geographic Coordinate Reference System"@en ;
    rdfs:subClassOf geosrs_srs:CRS ;
    skos:definition "Coordinate Reference System that has a geodetic reference frame and an ellipsoidal coordinate system"@en .

geosrs_srs:ParametricCRS a owl:Class ;
    rdfs:label "Parametric Coordinate Reference System"@en ;
    rdfs:subClassOf geosrs_srs:CRS ;
    skos:definition "Coordinate Reference System based on a parametric datum"@en .

geosrs_srs:SelenographicCRS a owl:Class ;
    rdfs:label "Selenographic CRS"@en ;
    rdfs:subClassOf geosrs_srs:CRS ;
    skos:definition "Coordinate Reference System to refer locations on the surface of the Earth’s Moon."@en .

geosrs_srs:SingleCRSList a owl:Class ;
    rdfs:label "Single CRS List"@en ;
    skos:definition "Ordered list of simple reference coordinate systems."@en .

geosrs_srs:SpatioParametricTemporalCompoundCRS a owl:Class ;
    rdfs:label "Spatio-Parametric Temporal Compound Coordinate Reference System"@en ;
    rdfs:subClassOf geosrs_srs:SpatioParametricCompoundCRS ;
    skos:definition "Coordinate reference system combining a spatio-parametric reference system with at least one temporal reference system"@en .

geosrs_srs:SpatioTemporalCompoundCRS a owl:Class ;
    rdfs:label "Spatio-Parametric Compound Coordinate Reference System"@en ;
    rdfs:subClassOf geosrs_srs:CompoundCRS ;
    skos:definition "Coordinate reference system combining a spatial reference system with at least one temporal reference system"@en .

geosrs_srs:StaticCRS a owl:Class ;
    rdfs:label "Static CRS"@en ;
    rdfs:subClassOf geosrs_srs:CRS ;
    skos:definition "Coordinate Reference System that has a static reference frame"@en .

geosrs_srs:TemporalCRS a owl:Class ;
    rdfs:label "Temporal CRS"@en ;
    rdfs:subClassOf geosrs_srs:CRS ;
    skos:definition "Coordinate Reference System based on a temporal datum"@en .

geosrs_srs:VerticalCRS a owl:Class ;
    rdfs:label "Vertical CRS"@en ;
    rdfs:subClassOf geosrs_srs:CRS ;
    skos:definition "One-dimensional coordinate reference system associated with a vertical datum and used for recording heights or depths.Ellipsoidal heights are not captured in a vertical coordinate reference system but as part of a 3D coordinates tuple defined in a geodetic 3D coordinate reference system. Cf. ISO 19111:2007:2007-07, parts 8.2.2.b, table 14 and annex B.1.2.1.b."@en .

geosrs:srssrs a owl:Ontology ;
    rdfs:label "SRS Ontology: Geosrs_srs"@en ;
    vann:preferredNamespacePrefix "geosrs_srs"^^xsd:string ;
    vann:preferredNamespaceUri "https://w3id.org/geosrs/srs/"^^xsd:anyURI .

geosrs:GeneralOperationParameter a owl:Class ;
    rdfs:label "General Operation Parameter"@en ;
    skos:definition "Definition of a parameter or group of parameters used by a coordinate operation method."@en .

geosrs:GeneralParameterValue a owl:Class ;
    rdfs:label "General Parameter Value"@en ;
    skos:definition "Parameter value or group of parameter values"@en .

geosrs:OperationMethod a owl:Class ;
    rdfs:label "Operation Method"@en ;
    skos:definition "Method used to perform an operation on coordinates. See ISO 19111:2007:2007-07, table 48 and annex B.4.5."@en .

geosrs:OrdinalCoordinateSystem a owl:Class ;
    rdfs:label "Ordinal Coordinate System"@en ;
    rdfs:subClassOf geosrs:CoordinateSystem ;
    skos:definition "n-dimensional coordinate system in which every axis uses integers."@en .

geosrs_srs:AreaOfUse a owl:Class ;
    rdfs:label "Area of use"@en ;
    rdfs:subClassOf <geo:Feature> ;
    skos:definition "Area within which a coordinate operation may be used."@en .

geosrs_srs:GeodeticCRS a owl:Class ;
    rdfs:label "Geodetic Coordinate Reference System"@en ;
    rdfs:subClassOf geosrs_srs:CRS ;
    skos:definition "Coordinate Reference System associated with a geodetic datum. Cf. ISO 19111:2007:2007-07, part 8.2.2.a, table 10 and annex B.1.2.1.a."@en .

geosrs_srs:ProjectedCRS a owl:Class ;
    rdfs:label "Projected Coordinate Reference System"@en ;
    rdfs:subClassOf geosrs_srs:CRS ;
    skos:definition "Coordinate Reference System derived from a two-dimensional geodetic coordinate reference system by applying a map projection. Cf. ISO 19111:2007:2007-07, part 8.2.3.b, table 11 and annex B.1.2.3."@en .

geosrs_srs:ReferenceSystem a owl:Class ;
    rdfs:label "Reference System"@en ;
    skos:definition "An abstract coordinate system, whose origin, orientation and scale are specified in physical space. It is based on a set of reference points, defined as geometric points whose position is identified physically and mathematically."@en .

geosrs_srs:SingleCRS a owl:Class ;
    rdfs:label "Single Coordinate Reference System"@en ;
    rdfs:subClassOf geosrs_srs:CRS ;
    skos:definition "Coordinate reference system consisting of one coordinate system and one datum. Cf. ISO 19111:2007:2007-07, table 5."@en .

geosrs_srs:SpatialReferenceSystem a owl:Class ;
    rdfs:label "Spatial Reference System"@en ;
    rdfs:subClassOf geosrs_srs:ReferenceSystem ;
    skos:definition "A spatial reference system (SRS) is a system for establishing spatial position. A spatial reference system can use geographic identifiers (place names, for example), coordinates (in which case it is a coordinate reference system), or identifiers with structured geometry (in which case it is a discrete global grid system)."@en .

geosrs_srs:SpatioParametricCompoundCRS a owl:Class ;
    rdfs:label "Spatio Parametric Compound Coordinate Reference System"@en ;
    rdfs:subClassOf geosrs_srs:CompoundCRS ;
    skos:definition "A spatio-parametric coordinate reference system is a compound CRS in which one component is a geographic 2D, projected 2D or engineering 2D CRS, supplemented by a parametric CRS to create a three-dimensional CRS"@en .

geosrs_srs:proj4Literal a owl:NamedIndividual,
        <rdf:Datatype> ;
    rdfs:label "Proj4 Literal"@en ;
    skos:definition "A literal which stores a proj4 String"@en .

geosrs_srs:projJSONLiteral a owl:NamedIndividual,
        <rdf:Dataype> ;
    rdfs:label "ProJJSON Literal"@en ;
    skos:definition "A literal which stores a projection JSON (ProjJSON) String"@en .

geosrs_srs:wktLiteral a owl:NamedIndividual,
        <rdf:Datatype> ;
    rdfs:label "WKT Literal"@en ;
    skos:definition "A literal which stores a WKT for CRS String"@en .

geosrs:Conversion a owl:Class ;
    rdfs:label "Conversion"@en ;
    rdfs:subClassOf geosrs:SingleOperation ;
    skos:definition "Coordinate operation in which both coordinate reference systems are based on the same datum. Cf. ISO 19111:2007:2007-07, table 45 and annex B.4.2."@en .

geosrs:CoordinateOperation a owl:Class ;
    rdfs:label "Coordinate Operation"@en ;
    rdfs:subClassOf geosrs:OperationMethod ;
    skos:definition "Mathematical operation on coordinates, based on one-to-one relationship, that changes coordinates from one coordinate reference system to another. Cf. ISO 19111:2007:2007-07, part 11.1, table 42 and annex B.4."@en .

geosrs:SingleOperation a owl:Class ;
    rdfs:label "Single Operation"@en ;
    rdfs:subClassOf geosrs:CoordinateOperation ;
    owl:disjointWith <https://w3id.org/geosrs/co/ConcatenatedOperation> ;
    skos:definition "A non concatenated coordinate operation. Cf. ISO 19111:2007:2007-07, table 43."@en .

geosrs_srs:CompoundCRS a owl:Class ;
    rdfs:label "Compound Coordinate Reference System"@en ;
    rdfs:subClassOf geosrs_srs:CRS ;
    skos:definition "Coordinate reference system using at least two independent single coordinate reference systems. Cf. ISO 19111:2007:2007-07, parts 8.2.3.c, 8.2.4, table 6 and annex B.1.2.4."@en .

geosrs:Datum a owl:Class ;
    rdfs:label "Datum"@en ;
    skos:definition "Parameter or set of parameters that define the position of the origin, the scale and the orientation of a coordinate system. Cf. ISO 19111:2007:2007-07, part 10.1, table 33 and annex B.3."@en .

geosrs:CoordinateSystem a owl:Class ;
    rdfs:label "Coordinate System"@en ;
    skos:definition "Set of axes that spans a given coordinate space and of mathematical rules for specifying how coordinates are to be assigned to points. Cf. ISO 19111:2007:2007-07, part 9.2, table 17 and annex B.2."@en .

geosrs_srs:CRS a owl:Class ;
    rdfs:label "Coordinate Reference System"@en ;
    rdfs:subClassOf geosrs_srs:SpatialReferenceSystem ;
    owl:disjointWith geosrs:Datum ;
    skos:definition "Depending on the spatial dimension of coordinates (1D, 2D, 3D), this piece of metadata is used for specifying the elements of definition associated to a given set of coordinates: its datum, its ellipsoid, its prime meridian, the type of coordinates (geocentric, geographic, projected,...), the coordinates units of measure, when appropriate the cartographic projection used, the vertical coordinate reference system."@en .

